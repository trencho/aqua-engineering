# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules

# Yarn Berry: commit the lockfile, ignore the rest of .yarn/. Yarn is
# Corepack-managed, so nothing lives under .yarn/releases here.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

dist
dist-ssr
coverage
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capture and backup workspaces: large binaries and working material from the
# previous site. Never committed.
_captured/
_backup/

# Local env
.env
.env.local
.env.*.local
