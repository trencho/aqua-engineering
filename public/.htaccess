# aquaengineering.mk — static Vue build
#
# Shipped from public/ so it is version-controlled and restored on every deploy.
# That matters: the deploy runs `rsync --delete`, so anything not in the build
# is removed from the document root.

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Retired WordPress surface -------------------------------------------
  # 410 Gone, not 404 and not 301. These paths are gone for good and should
  # leave the search index rather than be redirected into the new site.
  RewriteRule ^(.*-)?casino(-.*)?/?$        - [G,L,NC]
  RewriteRule ^pin-up-.*$                   - [G,L,NC]
  RewriteRule ^.*-kazino-.*$                - [G,L,NC]
  RewriteRule ^.*-kasynie-.*$               - [G,L,NC]
  RewriteRule ^(don-bet|vipluck|vodka-onlayn|martin-casino).*$ - [G,L,NC]
  RewriteRule ^test[0-9]+/?$                - [G,L,NC]

  # WordPress endpoints that no longer exist. Gone, so nothing keeps probing
  # them expecting the SPA shell to answer 200.
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php|wp-trackback\.php)$ - [G,L]
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$            - [G,L]
  RewriteRule ^(feed|comments/feed)/?$                                     - [G,L]

  # --- Per-locale shells ----------------------------------------------------
  # Each locale ships its own HTML with that language's metadata baked in, so
  # social unfurlers (which do not run JS) read the right one. This must sit
  # ABOVE the SPA fallback, or /mk falls through to the English shell.
  RewriteRule ^mk/?$              /mk/index.html         [L]
  RewriteRule ^privacy/?$         /privacy/index.html    [L]
  RewriteRule ^mk/privacy/?$      /mk/privacy/index.html [L]

  # --- SPA fallback ---------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Content-Security-Policy. script-src carries no 'unsafe-inline': the build
  # emits one external module and no inline script, so nothing legitimate
  # needs it and an injected <script> cannot run.
  #
  # style-src does allow 'unsafe-inline'. SiteLogo.vue inlines the wordmark SVG,
  # which carries its own <style> block, and a strict style-src would silently
  # strip the logo's fills. Inline CSS is a far weaker vector than inline JS,
  # and this is the one place it is needed.
  #
  # connect-src names the single third party the site talks to: the form
  # endpoint. Any other destination is blocked.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-src https://player.vimeo.com https://www.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # A staging deploy puts a second, broken copy of the site under /_staging/. robots.txt used to
  # carry a Disallow for it, which was the weaker control twice over: it only asks crawlers not to
  # FETCH the path, leaving a linked URL still indexable as a bare result, and robots.txt is public
  # so the line advertised that the directory exists. A noindex header prevents indexing outright
  # and says nothing to anyone who is not already there. SetEnvIf rather than <If> because LiteSpeed
  # serves this host and its <If> support is partial.
  SetEnvIf Request_URI "^/_staging/" STAGING_COPY
  Header always set X-Robots-Tag "noindex, nofollow" env=STAGING_COPY

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Hashed filenames, so these can be cached hard.
  <FilesMatch "\.(?:js|css|woff2|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The entry point is not hashed and must never be cached.
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nothing on this site is PHP. Denying execution keeps it that way.
<FilesMatch "\.(?:php|phtml|php[0-9]|phar|inc)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Leftovers from the previous WordPress install, should any survive.
<FilesMatch "^(wp-config\.php|\.env|\.htpasswd|.*\.sql|.*\.log|.*\.bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
