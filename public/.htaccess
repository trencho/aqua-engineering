# aquaengineering.mk — static Vue build
#
# Shipped from public/ so it is version-controlled and restored on every deploy.
# That matters: the deploy runs `rsync --delete`, so anything not in the build
# is removed from the document root.

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Retired WordPress surface -------------------------------------------
  # 410 Gone, not 404 and not 301. These URLs were spam injected between
  # 2026-07-29 and 2026-07-30 and should leave the index rather than be
  # redirected into the new site.
  RewriteRule ^(.*-)?casino(-.*)?/?$        - [G,L,NC]
  RewriteRule ^pin-up-.*$                   - [G,L,NC]
  RewriteRule ^.*-kazino-.*$                - [G,L,NC]
  RewriteRule ^.*-kasynie-.*$               - [G,L,NC]
  RewriteRule ^(don-bet|vipluck|vodka-onlayn|martin-casino).*$ - [G,L,NC]
  RewriteRule ^test[0-9]+/?$                - [G,L,NC]

  # WordPress endpoints that no longer exist. Gone, so nothing keeps probing
  # them expecting the SPA shell to answer 200.
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php|wp-trackback\.php)$ - [G,L]
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$            - [G,L]
  RewriteRule ^(feed|comments/feed)/?$                                     - [G,L]

  # --- SPA fallback ---------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Hashed filenames, so these can be cached hard.
  <FilesMatch "\.(?:js|css|woff2|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The entry point is not hashed and must never be cached.
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nothing on this site is PHP, and nothing on this account should execute PHP
# from the document root again. 
<FilesMatch "\.(?:php|phtml|php[0-9]|phar|inc)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Leftovers from the WordPress install, should any survive the wipe.
<FilesMatch "^(wp-config\.php|\.env|\.htpasswd|.*\.sql|.*\.log|.*\.bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
