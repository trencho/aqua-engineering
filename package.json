{
  "name": "aqua-engineering",
  "private": true,
  "version": "1.0.0",
  "description": "Static site for Aqua Engineering, a water and environmental consultancy in Skopje",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-image-optimizer": "2.0.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
